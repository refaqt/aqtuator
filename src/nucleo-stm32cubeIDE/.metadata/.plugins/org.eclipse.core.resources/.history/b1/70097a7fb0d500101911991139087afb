/**
  * @brief  Send torque command to ODrive S1 via CAN
  * @param  torque: Torque value in Nm
  * @retval None
  */
static void ODrive_SendTorqueCommand(float torque)
{
  MCP2515_CanMessage_t can_msg;
  uint8_t *torque_bytes = (uint8_t *)&torque;
  uint8_t i;

  /* Set CAN message ID: 0x00E for Set_Input_Torque command (node 0) */
  can_msg.id = ODRIVE_CMD_SET_INPUT_TORQUE;
  
  /* Set data length: 4 bytes for float */
  can_msg.dlc = 4;
  
  /* Copy float bytes (little-endian) */
  for (i = 0; i < 4; i++) {
    can_msg.data[i] = torque_bytes[i];
  }
  
  /* Send CAN message */
  if (MCP2515_SendMessage(&hspi1, CAN_CS_PORT, CAN_CS_PIN, &can_msg) != HAL_OK) {
    /* Error sending message - could add error handling here */
  }
}

